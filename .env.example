# Jina AI API Key — used for Reader, CLIP, VLM (direct API calls)
JINA_API_KEY=jina_...

# Elasticsearch — EIS cluster for Embeddings + Reranker
ELASTICSEARCH_URL=https://your-cluster.es.io
ELASTICSEARCH_API_KEY=your_api_key_here

# Kibana — used for Agent Builder
KIBANA_URL=https://your-project.kb.us-east-1.aws.found.io
KIBANA_API_KEY=your_kibana_api_key_here
AGENT_ID=your-agent-builder-agent-id
AGENT_CONNECTOR_ID=Google-Gemini-2-5-Flash

# Gemini — used by nano-banana for hotel image generation
GEMINI_API_KEY=AIza...
